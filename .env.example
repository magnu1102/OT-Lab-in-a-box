# Operator and engineer UIs — the only host-published services in Phase 4.
HMI_PORT=3000
GRAFANA_PORT=3001

# Simulator
SIM_TICK_SECONDS=0.5

# Historian + PostgreSQL
POSTGRES_DB=ot_lab
POSTGRES_USER=ot_lab
POSTGRES_PASSWORD=change_me
HISTORIAN_POLL_INTERVAL_SECONDS=2

# Grafana admin (anonymous Viewer is enabled separately in compose).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
