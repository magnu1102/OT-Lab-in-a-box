      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "Postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', timestamp) AS time, count(*)::int AS \"rows per minute\" FROM process_readings WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1",
